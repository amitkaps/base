{
  "name": "base",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "prose": "prose",
    "build": "SVELTEKIT_OUT_DIR=.svelte-kit/build vp build",
    "preview": "SVELTEKIT_OUT_DIR=.svelte-kit/build vp preview",
    "check": "svelte-kit sync && wrangler types && vp check && rm -rf .svelte-kit/.svelte-check && svelte-check --tsgo --tsconfig ./tsconfig.json && pnpm prose check && pnpm craftz check",
    "fix": "vp check --fix",
    "test": "vp test --run",
    "verify": "vp run --log grouped all",
    "ship": "craftz deploy",
    "prepare": "svelte-kit sync && wrangler types",
    "pr": "craftz pr",
    "gone": "craftz gone",
    "craftz": "craftz",
    "outline": "prose outline"
  },
  "devDependencies": {
    "@amitkaps/craftz": "0.24.0",
    "@amitkaps/markz": "0.9.0",
    "@amitkaps/prose": "0.12.0",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite-plus": "1.6.0",
    "wrangler": "4.161.0",
    "zod": "^4.6.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.19.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26.13.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "pnpm@12.19.0",
  "craftz": {
    "hold": {
      "versions-typescript": "svelte-check accepts TypeScript 5 and 6 only. Move when its peer range takes 7.",
      "cloudflare-config": "cf can't deploy SvelteKit, since the adapter doesn't write cf's Build Output. Move when it does.",
      "toolchain-types": "SvelteKit needs $app/types in types, and checkJs off, or svelte-check reads the Worker wrangler builds. Move when either changes."
    }
  }
}
