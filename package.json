{
  "name": "base",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "prose": "prose .",
    "build": "vite build",
    "check": "svelte-kit sync && wrangler types && oxfmt --check && pnpm lint && svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint --type-aware --import-plugin --deny-warnings",
    "fix": "oxfmt && pnpm lint --fix",
    "test": "vitest run",
    "deploy": "vite build && wrangler deploy",
    "prepare": "svelte-kit sync && wrangler types"
  },
  "devDependencies": {
    "@amitkaps/markz": "^0.3.0",
    "@amitkaps/prose": "^0.4.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@types/node": "^26.0.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0",
    "zod": "^4.6.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.9.1"
}
