{
	"name": "sveltekit-starter",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#content": "./.content-collections/generated/index.js"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "pnpm sync && vp build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"clean": "node scripts/clean.mjs",
		"sync": "pnpm clean && svelte-kit sync && wrangler types && content-collections build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm sync && vp check",
		"check:fix": "pnpm sync && vp check --fix",
		"check:svelte": "pnpm sync && svelte-check --tsconfig ./tsconfig.json",
		"check:svelte:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vp test --run",
		"test:watch": "vp test",
		"deploy": "pnpm build && wrangler deploy",
		"gen": "wrangler types"
	},
	"dependencies": {
		"bits-ui": "^2.19.1",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260908.1",
		"@content-collections/cli": "^0.1.9",
		"@content-collections/core": "^0.15.2",
		"@content-collections/markdown": "^0.1.4",
		"@content-collections/vite": "^0.3.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0-next.6",
		"@sveltejs/kit": "^3.0.0-next.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.0.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
		"vite-plus": "0.3.1",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.4.0"
}
