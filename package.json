{
	"name": "sveltekit-starter",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"check": "svelte-kit sync && vp check",
		"check:fix": "svelte-kit sync && vp check --fix",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:svelte:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vp test --run",
		"test:watch": "vp test",
		"prepare": "svelte-kit sync",
		"gen": "wrangler types",
		"deploy": "vp build && wrangler deploy"
	},
	"dependencies": {
		"bits-ui": "^2.19.1",
		"js-yaml": "^5.4.1",
		"marked": "^18.0.12",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260908.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0-next.6",
		"@sveltejs/kit": "^3.0.0-next.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.0.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
		"vite-plus": "0.3.1",
		"wrangler": "^4.97.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24",
			"onFail": "error"
		}
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.4.0"
}
