{
  "name": "base",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "prose": "prose .",
    "build": "vp build",
    "check": "svelte-kit sync && wrangler types && vp check && svelte-check --tsconfig ./tsconfig.json",
    "test": "vp test --run",
    "deploy": "vp build && wrangler deploy",
    "prepare": "svelte-kit sync && wrangler types"
  },
  "devDependencies": {
    "@amitkaps/prose": "^0.3.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "marked": "^18.0.14",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "wrangler": "^4.146.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.8.1"
}
