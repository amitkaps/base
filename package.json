{
  "name": "base",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "prose": "prose",
    "build": "vp build",
    "preview": "vp preview",
    "check": "svelte-kit sync && wrangler types && vp check && svelte-check --tsconfig ./tsconfig.json",
    "fix": "vp check --fix",
    "test": "vp test --run",
    "verify": "pnpm check && pnpm prose check && pnpm test && pnpm build",
    "ship": "wrangler deploy",
    "prepare": "svelte-kit sync && wrangler types",
    "pr": "node scripts/pr.ts",
    "gone": "node scripts/gone.ts"
  },
  "devDependencies": {
    "@amitkaps/markz": "^0.4.2",
    "@amitkaps/prose": "^0.7.1",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite-plus": "1.3.0",
    "wrangler": "^4.151.0",
    "zod": "^4.6.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.13.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.13.0"
}
